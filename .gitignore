# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright artifacts
playwright-report/
test-results/

# Supabase CLI scratch — project ref, linked-project.json, version stamps.
# Regenerated by the CLI; committing it would put the project ref in git.
supabase/.temp/

# Generated by `deno check` on the edge functions. Nothing in CI runs Deno,
# so this is a local artifact rather than a lockfile anyone else reads.
deno.lock
